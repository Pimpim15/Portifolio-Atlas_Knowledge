environment                = "stage"
aws_region                 = "us-east-1"
alb_certificate_arn        = "arn:aws:acm:us-east-1:123456789012:certificate/example-stage"
vpc_az_count               = 2
vpc_nat_gateway_per_az     = false
enable_rds_secret_rotation = false
